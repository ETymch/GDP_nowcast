# Библиотеки ===================================================================

library(tidyverse)
library(MARSS)
library(arrow)

# Начало =======================================================================

y <- read_parquet('data_input/data_q.parquet') %>%
  arrange(date) %>%
  select(-date) %>%
  t()

# Модель

marss_1st <- function(y,
                      error_gdp = 0.01,
                      maxit = 300){
  
  m <- nrow(y)
  
  Z <- matrix(c(1, paste0('z', 2:m)), m, 1)
  A <- matrix(paste0('a', 1:m), m, 1)
  B <- matrix('b')
  U <- matrix(0)
  Q <- matrix("q")
  x0 <- matrix(0)
  
  # матрица ошибок наблюдений
  
  R <- matrix(list(0), m, m)
  
  R[1, 1] <- error_gdp
  
  for (i in 2:m) {
    R[[i, i]] <- paste0("r", i)
  }
  
  model <- MARSS(
    y,
    model = list(
      Z = Z,
      A = A,
      B = B,
      U = U,
      R = R,#'diagonal and unequal',
      Q = Q,
      x0 = x0
    ),
    control = list(maxit = maxit)
  )
  
  MARSSresiduals(model)
  
}

marss_1st <- function(y, maxit = 1000) {
  
  m <- nrow(y)
  
  Z <- matrix(paste0("z", 1:m), m, 1)
  A <- matrix(paste0("a", 1:m), m, 1)
  B <- matrix("b")
  U <- matrix(0)
  Q <- matrix("q")
  x0 <- matrix(0)
  
  model <- MARSS(
    y,
    model = list(
      Z = Z,
      A = A,
      B = B,
      U = U,
      R = "diagonal and unequal",
      Q = Q,
      x0 = x0
    ),
    method = "BFGS",
    control = list(maxit = maxit)
  )
  
  model
}

marss_1st_1 <- function(y, maxit = 1000) {
  
  m <- nrow(y)
  
  Z <- matrix(list(0), m, 1)
  Z[[1, 1]] <- 1
  Z[2:m, 1] <- as.list(paste0("z", 2:m))
  
  A <- matrix(paste0("a", 1:m), m, 1)
  B <- matrix("b")
  U <- matrix(0)
  Q <- matrix("q")
  x0 <- matrix(0)
  
  model <- MARSS(
    y,
    model = list(
      Z = Z,
      A = A,
      B = B,
      U = U,
      R = "diagonal and unequal",
      Q = Q,
      x0 = x0
    ),
    method = "BFGS",
    control = list(maxit = maxit)
  )
  
  model
}

mod <- marss_1st(y)
mod_1 <- marss_1st_1(y)

