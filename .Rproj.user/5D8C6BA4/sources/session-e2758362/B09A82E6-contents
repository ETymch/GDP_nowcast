## 6. Бенчмарк скорости

В отдельных файлах я реализовал бенчмарки скрорсти для всех алгоритмов в статье. Для бенчмарков использовались данные

* Розничные продажи пива (квартальные + мало наблюдений)
* Промпроизводство (месячные + среднее кол-во наблюдений)
* Температуры (дневные + тысячи наблюдений)

В таблице видно как алгоритмы показывают себя с ростом кол-ва наблюдений.

```{r}
#| label: benchmark-table
#| message: false

library(kableExtra)

if (!file.exists("benchmark_results.csv")) {
  knitr::asis_output(
    "<p><em>Таблица не сгенерирована. Запустите <code>Rscript run_benchmarks.R</code> в каталоге <code>Seasonality/</code>.</em></p>"
  )
} else {

benchmark_df <- read_csv("benchmark_results.csv", show_col_types = FALSE)

bench_show <- benchmark_df %>%
  mutate(
    `Время, с` = sprintf("%.3f", time_sec),
    `× к мин.` = rel_min
  ) %>%
  select(
    Ряд = series, `n`, Периодичность = periodicity, Метод = method,
    Язык = lang, Пакет = package, Тип = impl_type,
    `Время, с`, `× к мин.`, Примечание = note
  )

idx_prom <- which(benchmark_df$series == "Промышленное производство")
idx_beer <- which(benchmark_df$series == "Розничные продажи пива")
idx_temp <- which(benchmark_df$series == "Температура, Н. Новгород")
fast_rows <- which(benchmark_df$rel_min == 1)

bench_show %>%
  kableExtra::kbl(
    align = c("l", "r", "l", "l", "l", "l", "l", "r", "r", "l"),
    format = "html",
    caption = "Бенчмарк: медианное время подгонки моделей (секунды)"
  ) %>%
  kableExtra::kable_styling(
    bootstrap_options = c("striped", "hover", "condensed"),
    full_width = TRUE,
    font_size = 13,
    position = "center"
  ) %>%
  kableExtra::scroll_box(width = "100%", height = "520px") %>%
  kableExtra::column_spec(8, color = "#1a5276", bold = TRUE) %>%
  kableExtra::column_spec(9, bold = TRUE,
    color = ifelse(benchmark_df$rel_min <= 2, "#145a32", "#7b241c")) %>%
  kableExtra::row_spec(fast_rows, background = "#eafaf1") %>%
  kableExtra::pack_rows("Промышленное производство", min(idx_prom), max(idx_prom)) %>%
  kableExtra::pack_rows("Розничные продажи пива", min(idx_beer), max(idx_beer)) %>%
  kableExtra::pack_rows("Температура, Н. Новгород", min(idx_temp), max(idx_temp)) %>%
  kableExtra::footnote(
    general = paste(
      "Зелёная строка — быстрейший метод в ряду (× к мин. = 1).",
