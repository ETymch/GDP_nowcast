#| fig-cap: "Prophet: декомпозиция дневной температуры в Нижнем Новгороде"
#| message: false
#| warning: false

library(prophet)

df_prophet <- read_parquet("data_temp.parquet") %>%
  filter(town == "Нижний Новгород") %>%
  arrange(time) %>%
  select(ds = time, y = temp) %>%
  mutate(ds = as_date(ds)) %>%
  filter(!is.na(y))

m_prophet <- prophet(
  df_prophet,
  yearly.seasonality  = T, # Циклы с периодичностью 1 год
  weekly.seasonality  = F, # Циклы с периодичностью неделя
  daily.seasonality   = F, # Циклы с периодичностью 1 день (для внутридневных данных)
  seasonality.mode    = "additive"
)

future  <- make_future_dataframe(m_prophet, periods = 90)
fc      <- predict(m_prophet, future)

prophet_plot_components(m_prophet, fc)
```

