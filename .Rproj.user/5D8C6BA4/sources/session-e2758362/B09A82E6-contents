#| message: false

temp_novosib <- read_parquet("data_temp.parquet") %>%
  filter(town == "Нижний Новгород") %>%
  arrange(time) %>%
  select(time, temp) %>%
  filter(!is.na(temp))

temp_mts <- temp_novosib %>%
  pull(temp) %>%
  msts(seasonal.periods = c(7, 365.25))

mstl(temp_mts) %>%
  autoplot() +
  theme_minimal(base_size = 11) +
  labs(title = NULL)
```

