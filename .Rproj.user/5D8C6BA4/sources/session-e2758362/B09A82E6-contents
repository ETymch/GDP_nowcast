#| fig-cap: "Разница SA-рядов: с учётом праздников минус без"
#| fig-height: 3.5

n_obs <- length(prom_raw)
tibble(
  date   = seq(as.Date("2013-01-01"), by = "month", length.out = n_obs),
  d_genhol = as.numeric(prom_s2) - as.numeric(prom_s0),
  d_hol    = as.numeric(prom_s3) - as.numeric(prom_s0)
) %>%
  pivot_longer(-date, names_to = "method",
               names_ptypes = list(method = factor())) %>%
  mutate(method = recode(method,
    d_genhol = "X11 + genhol − SEATS",
    d_hol    = "X11 + hol_new_1 − SEATS"
  )) %>%
  ggplot(aes(x = date, y = value, colour = method)) +
  geom_hline(yintercept = 0, linetype = "dashed", colour = "grey70") +
  geom_line(linewidth = 0.7) +
  scale_x_date(date_breaks = "2 years", date_labels = "%Y") +
  scale_colour_manual(values = c(
    "X11 + genhol − SEATS"    = "#2C7BB6",
    "X11 + hol_new_1 − SEATS" = "#D7191C"
  )) +
  theme_minimal(base_size = 12) +
  labs(x = NULL, y = "Δ log(ИПП)", colour = NULL) +
  theme(legend.position = "bottom")
```

Поправка максимальна в январе–феврале и мае. Разница между `genhol` и `hol_new_1` видна в годах с нестандартным календарём (2018, 2020, 2024): именно там переносы выходных меняют долю праздничных дней в месяце, и только `prom_s3` это учитывает.

