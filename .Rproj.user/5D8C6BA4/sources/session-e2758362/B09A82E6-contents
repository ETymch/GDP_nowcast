#### Julia

```{julia}
#| label: fig-x13-jl
#| fig-cap: "Промышленное производство: BSM из StateSpaceModels.jl (Julia)"
#| message: false
#| warning: false

begin

  data_seas_jl = CSV.read("_seasonality.csv", DataFrame; dateformat="yyyy-mm-dd")
  sort!(data_seas_jl, :Date)
  
  y_prom = log.(Float64.(data_seas_jl.Prom_M))
  
  # BSM: уровень + наклон + стохастическая сезонность (период 12)
  # StateSpaceModels.jl: BasicStructural(y, seasonality)
  model_bsm = BasicStructural(y_prom, 12)
  StateSpaceModels.fit!(model_bsm)
  
  ss = kalman_smoother(model_bsm)
  # alpha — Vector{Vector{Float64}}: alpha[t] — вектор состояния в момент t
  # Структура: [уровень, наклон, γ_t, γ_{t-1}, ..., γ_{t-10}]
  seasonal_bsm = getindex.(ss.alpha, 3)   # γ_t для каждого t
  sa_bsm = y_prom .- seasonal_bsm
  
  plot(data_seas_jl.Date,
       [y_prom sa_bsm];
       label=["Исходный" "BSM SA"],
       lw=[0.4 0.9],
       color=["grey60" "#2C7BB6"],
       alpha=[0.8 1.0],
       ylabel="log(ИПП)",
       legend=:bottomleft,
       size=(800, 600))

end
```

:::

SEATS и X11 дают очень близкие результаты — расхождения видны только в периоды структурных сдвигов (2014–2015, 2022). SEATS опирается на явную оптимальную фильтрацию в рамках ARIMA-модели; X11 менее параметричен, но исторически хорошо проверен. Julia-вариант через BSM даёт результат, близкий к SEATS: оба метода оценивают одну и ту же стохастическую модель максимального правдоподобия.

