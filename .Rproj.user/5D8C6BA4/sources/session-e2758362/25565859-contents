# =============================================================================
# Врезка 05. Тепличное грибоводство на Тайване: частная сеть 5G и компьютерное
#            зрение вместо ежедневного обхода теплицы
# -----------------------------------------------------------------------------
# Источник данных: MDPI Electronics, 2025, 14(18), 3594,
#   https://www.mdpi.com/2079-9292/14/18/3594   (строка 14 базы 5g_cases_v5)
#   Из источника взяты две величины: ежедневный ручной осмотр 1-3 ч и
#   длительность цикла выращивания 30-60 дней. Значения в ячейках - их
#   произведение, то есть объём ручного труда, замещаемый за один цикл.
# Выход: viz_05_Грибоводство_Тайвань.png, 1800 x 900 px
#
# ЗАПУСК. В локали C кириллица в PNG не отрисуется (вместо букв - точки):
#   Linux/macOS: LC_ALL=ru_RU.UTF-8 Rscript viz_05_Грибоводство_Тайвань.R
#   Windows:     Sys.setlocale("LC_CTYPE", "Russian")
# =============================================================================

library(ggplot2)
library(tibble)

FONT <- "HSE Sans"
col_note <- "#595959"

# --- данные ------------------------------------------------------------------
dat <- tibble(
  cycle_days = rep(c(30, 60), each = 2),
  hours_day  = rep(c(1, 3), times = 2),
  hours_cycle = cycle_days * hours_day
)
dat$cycle_lab <- factor(paste0("цикл ", dat$cycle_days, " дней"),
                        levels = c("цикл 30 дней", "цикл 60 дней"))
dat$hours_lab <- factor(paste0(dat$hours_day, " ч в день"),
                        levels = c("3 ч в день", "1 ч в день"))

theme_vrezka <- function(base = 13) {
  theme_minimal(base_size = base, base_family = FONT) +
    theme(
      plot.title            = element_text(face = "bold", size = base * 1.15, margin = margin(b = 4)),
      plot.subtitle         = element_text(colour = col_note, size = base * 0.92, margin = margin(b = 14)),
      plot.caption          = element_text(colour = col_note, size = base * 0.68, hjust = 0,
                                           margin = margin(t = 12), lineheight = 1.15),
      plot.caption.position = "plot", plot.title.position = "plot",
      axis.text             = element_text(size = base * 0.95),
      axis.title.x          = element_text(colour = col_note, size = base * 0.85, margin = margin(t = 8)),
      axis.title.y          = element_text(colour = col_note, size = base * 0.85, margin = margin(r = 8)),
      panel.grid            = element_blank(),
      legend.position       = "none",
      plot.margin           = margin(12, 150, 8, 12)
    )
}

p <- ggplot(dat, aes(x = cycle_lab, y = hours_lab, fill = hours_cycle)) +
  geom_tile(colour = "white", linewidth = 3) +
  geom_text(aes(label = paste0(hours_cycle, " ч"),
                colour = ifelse(hours_cycle > 100, "light", "dark")),
            size = 7.5, fontface = "bold", family = FONT) +
  scale_fill_gradient(low = "#DAE3F3", high = "#1F4E79") +
  scale_colour_manual(values = c(light = "white", dark = "#1F4E79")) +
  annotate("text", x = 2.72, y = 1.5, hjust = 0, family = FONT, size = 4, colour = col_note,
           lineheight = 1.12,
           label = paste0("Столько часов ежедневного\n",
                          "визуального контроля роста\n",
                          "и заражения замещает\n",
                          "видеонаблюдение на частной\n",
                          "сети 5G за один цикл\n",
                          "выращивания")) +
  coord_cartesian(xlim = c(0.5, 2.5), clip = "off") +
  labs(
    #title    = "Оператор с фонариком против камеры с нейросетью",
    #subtitle = "Тепличное грибоводство, Тайвань: объём ручного труда, замещаемый за один цикл выращивания",
    x = "Длительность цикла выращивания", y = "Ежедневный ручной осмотр",
    caption  = paste0(
      "Источник: MDPI Electronics, 2025, 14(18), 3594, раздел результатов. Из источника взяты продолжительность\n",
      "ручного осмотра (1–3 ч в день) и длительность цикла (30–60 дней); значения в ячейках – их произведение.\n",
      "Контрфакт – ручной осмотр, а не 4G или Wi-Fi: измерен эффект автоматизации, а не эффект поколения связи.")
  ) +
  theme_vrezka()

ggsave("viz_05_Грибоводство_Тайвань.png", p, width = 10.5, height = 4.5, dpi = 400)
cat("Готово: viz_05\n")
